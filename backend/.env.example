# Copiá este archivo como ".env" y completá con los datos de tu proyecto de Supabase
# (Dashboard -> Project Settings -> API Keys).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usá la "Secret key" (empieza con sb_secret_). NUNCA va en la app, solo acá en el servidor.
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxx
